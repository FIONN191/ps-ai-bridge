{
  "manifestVersion": 5,
  "id": "com.fionn.psaibridge",
  "name": "AI 生图贴回",
  "version": "0.5.1",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "25.0.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "aiBridgePanel",
      "label": {
        "default": "AI 生图贴回"
      },
      "minimumSize": {
        "width": 260,
        "height": 420
      },
      "maximumSize": {
        "width": 2000,
        "height": 3000
      },
      "preferredDockedSize": {
        "width": 320,
        "height": 760
      },
      "preferredFloatingSize": {
        "width": 340,
        "height": 820
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "all"
          ]
        }
      ]
    },
    {
      "type": "command",
      "id": "cmdGenerate",
      "label": {
        "default": "生成并贴回"
      }
    },
    {
      "type": "command",
      "id": "cmdRefSelection",
      "label": {
        "default": "选区加参考图"
      }
    },
    {
      "type": "command",
      "id": "cmdRefScreenshot",
      "label": {
        "default": "截图加参考图"
      }
    },
    {
      "type": "command",
      "id": "cmdNextProvider",
      "label": {
        "default": "换下一个平台"
      }
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "all"
      ],
      "species": [
        "pluginList"
      ]
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": "all"
    },
    "localFileSystem": "request"
  }
}
